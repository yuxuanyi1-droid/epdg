# The Gx/S6b Diameter test peer (test/integration/diampeer).
#
# It stands in for the two Diameter nodes that a PGW-C requires for an S2b
# (WLAN) session but that this repository does not provide: the PCRF (Gx) and the
# 3GPP AAA server (S6b). PyHSS implements Cx, Sh, Rx, Gx and S6a, but not S6b, so
# without this peer Open5GS refuses every S2b session with cause 100.
#
# It is a test double, not a product component, and deploy/README.md says so.
FROM golang:1.24-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY test ./test
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/diampeer ./test/integration/diampeer

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/diampeer /usr/local/bin/diampeer
EXPOSE 3868
ENTRYPOINT ["/usr/local/bin/diampeer"]
